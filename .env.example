# Only for the full-stack local mode (README, "Run it live"). The static demo needs none of these.
# Copy this file to .env and fill in your own values; .env is git-ignored. `npx netlify dev` and
# `npx netlify dev:exec` read it.

# Gemini (functions, evals, replay recorder). The model ids are optional; the defaults are in
# src/config/models.ts.
GEMINI_API_KEY=
GEMINI_MODEL_RUNTIME=
GEMINI_MODEL_JUDGE=

# Supabase, server side (functions and scripts). The service-role key never reaches the browser.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Supabase, browser side: the same URL and the anon key, read by the full-stack build.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Any string. The demo reset asks for it once per tab.
DEMO_RESET_TOKEN=
